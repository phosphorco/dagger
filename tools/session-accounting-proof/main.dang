"""Unpublished native source qualification only. No engine binary, image or runtime activation."""
type NativeSessionAccountingProof {
  """One bounded no-child leaf using explicit source, module SOURCE and negative-control files."""
  pub result(source: Directory!, modules: Directory!, controls: Directory!): Directory! {
    let run = container(platform: "linux/amd64")
      .from("golang@sha256:4013ae0f9e7994f8535c58c811f8f863fbed38b72e0d51e6592156f758d66146")
      .withDirectory("/src", source)
      .withDirectory("/go/mod", modules)
      .withDirectory("/controls", controls)
      .withDirectory("/out", directory)
      .withEnvVariable("GOTOOLCHAIN", "local")
      .withEnvVariable("GOENV", "off")
      .withEnvVariable("GOWORK", "off")
      .withEnvVariable("GOPROXY", "off")
      .withEnvVariable("GOSUMDB", "off")
      .withEnvVariable("GOMODCACHE", "/go/mod")
      .withEnvVariable("GOCACHE", "/tmp/native-accounting-go-build")
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOMAXPROCS", "2")
      .withEnvVariable("GOMEMLIMIT", "2GiB")
      .withEnvVariable("GOFLAGS", "-p=2")
      .withWorkdir("/src")
      .withExec(["timeout", "-k", "5s", "600s", "sh", "tools/session-accounting-proof/run.sh"], disableDaggerInDagger: true, expect: ReturnType.ANY)
    directory.withDirectory("artifacts", run.directory("/out"))
      .withNewFile("exit-code", toString(run.exitCode))
      .withNewFile("stdout.txt", run.stdout)
      .withNewFile("stderr.txt", run.stderr)
  }
}
